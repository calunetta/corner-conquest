rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usernames collection: reserve usernames by playerId
    // Prevents one player from stealing another player's username reservation
    match /usernames/{username} {
      // Allow reading to check availability (src/hooks/use-player.tsx line 20-21)
      allow read;

      // A guest reservation has authUid == null; an account reservation has authUid == the
      // owning Firebase Auth uid and additionally requires that account not already own a
      // username ("pick once, keep forever" — src/modules/session/services/account.service.ts).
      allow create: if request.resource.data.playerId is string &&
        (request.resource.data.authUid == null ||
         (request.resource.data.authUid is string &&
          request.auth != null &&
          request.resource.data.authUid == request.auth.uid &&
          !exists(/databases/$(database)/documents/accounts/$(request.auth.uid))));

      // Guest reservations can be re-claimed with the same playerId, exactly as before.
      // Account reservations (authUid != null) are permanent: no update, ever.
      // get(..., null) because guest reservations written before authUid existed have no such
      // field; a plain resource.data.authUid read would error and lock those reservations.
      // The merged request.resource.data also lacks authUid for a legacy doc, so it gets the same treatment.
      allow update: if
        resource.data.get('authUid', null) == null &&
        request.resource.data.get('authUid', null) == null &&
        resource.data.playerId is string &&
        request.resource.data.playerId is string &&
        resource.data.playerId == request.resource.data.playerId;

      // Guest reservations can be released on logout/beforeunload, exactly as before.
      // Account reservations are permanent: no delete, ever.
      allow delete: if resource.data.get('authUid', null) == null;
    }

    // Reverse lookup: which username does this Firebase Auth account own. Written once,
    // atomically with the usernames/{username} doc, by account.service.ts's bindUsernameToAccount.
    match /accounts/{authUid} {
      allow read;
      allow create: if request.auth != null &&
        request.auth.uid == authUid &&
        request.resource.data.username is string;
      allow update: if false; // picking a username is a one-time action
      allow delete: if false; // never released, by design
    }

    // Games collection: games created by players
    // Allow all players to read game state (src/hooks/use-game-engine.ts line 41-54)
    // Allow writes to new games (anyone can start) and existing games (host updates game logic)
    match /games/{gameId} {
      allow read;

      // Allow creating new games (someone must start the game)
      allow create;

      // Allow updating existing games. Since the app has no Firebase Auth and identity
      // is client-side only (playerId in localStorage), we cannot enforce per-player
      // write restrictions at the Firestore level without including playerId in the write.
      // The app's game logic (src/lib/actions) validates moves are legal per player.
      // We do require that writes maintain a non-empty players array to prevent
      // structural corruption. See src/hooks/use-game-engine.ts line 26 (setDoc with
      // GameState) and line 130 (updateDoc for deathAnimations).
      allow update: if
        request.resource.data.players is list &&
        request.resource.data.players.size() > 0;

      allow delete;
    }
  }
}
