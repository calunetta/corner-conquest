rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows read/write access to the 'games' collection and all
    // documents and subcollections within it, like /games/{gameId}/static/map
    match /games/{gameId}/{document=**} {
      allow read, write;
    }

    match /usernames/{username} {
      allow read, write;
    }
  }
}
