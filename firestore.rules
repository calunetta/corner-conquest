rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading and writing to individual game documents
    match /games/{gameId} {
      allow read, write: if true;
    }
    // Allow reading and writing to the usernames collection for uniqueness check
    match /usernames/{username} {
      allow read, write: if true;
    }
  }
}
